#!/usr/bin/env bash
# Meta repository quality gate (no CI).
set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS BROWSER
root="$(git rev-parse --show-toplevel)"
if [ "${BENNETT_GATE_HOOK_PROBE:-}" = 1 ]; then
  echo "bennett-gate-hook-chained $root"
  exit 0
fi
cd "$root"
export TMPDIR="$root/.tmp/meta-tests/tmp"
mkdir -p "$TMPDIR"
python3 - <<'PY'
import sys
import unittest
suite = unittest.defaultTestLoader.discover('tools/tests')
if suite.countTestCases() == 0:
    sys.exit('pre-push: no tests discovered under tools/tests')
PY
exec python3 -m unittest discover tools/tests
