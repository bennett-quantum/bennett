+                        Err(e) if !e.to_string().contains("§9.1") => failures.push(format!(
+                            "{name} {section}.{path:?} {}: {e}",
+                            next.canonical()
+                        )),
+                        Err(_) => {}
+                    }
+                }
+            }
+        }
+    }
+    eprintln!("R13 schema: {positives} positive objects, {fields} field visits, {negatives} negative mutations");
+    assert!(
+        failures.is_empty(),
+        "{} failures:\n{}",
+        failures.len(),
+        failures.join("\n")
+    );
