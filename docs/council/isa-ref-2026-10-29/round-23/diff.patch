+                        let i = usize::try_from(witness.get("claim_index")?.uint()?)
+                            .map_err(|_| Error::new("§12: claim index".into()))?;
+                        if certificate.get("regions")?.object()?.contains_key(library) {
+                            self.verify_claim_guarded(library, i, active)?
