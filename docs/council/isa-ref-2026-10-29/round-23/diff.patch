+                            return err("§12.1", "expected program has a different signature");
+                        }
+                        let other = self.execute_element(p, &element, budget)?;
+                        if other != out {
+                            return err("§12.1", format!("claim {index} of {closure}: element {row} differs from the expected program"));
+                        }
