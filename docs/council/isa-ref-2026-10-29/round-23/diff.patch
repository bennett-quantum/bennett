+                assert_eq!(a.as_ptr(), b.as_ptr());
+                assert_eq!(a, b);
+            } else {
+                r.unwrap().push(1);
+                assert_eq!(a.len(), len);
+                assert_eq!(b.len(), len + 1);
+                assert_eq!(b[len], 1);
+                b.truncate(len);
+                assert_eq!(a, b);
+            }
+        }
