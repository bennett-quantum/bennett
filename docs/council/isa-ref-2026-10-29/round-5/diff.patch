+impl Interval {
+    fn point(x: Dyadic) -> Self {
+        Self {
+            lo: x.clone(),
+            hi: x,
+        }
+    }
+    fn int(x: i128) -> Self {
+        Self::point(Dyadic::int(x))
+    }
+    fn bounds(lo: Dyadic, hi: Dyadic, p: u64) -> Self {
+        Self {
+            lo: rounded(&lo, p, false),
+            hi: rounded(&hi, p, true),
+        }
+    }
+    fn add(&self, b: &Self, p: u64) -> Self {
