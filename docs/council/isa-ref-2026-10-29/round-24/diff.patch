+                assert_eq!(m.outcome().steps, frames);
+                assert_eq!(m.step_once().unwrap_err(), e);
+                assert_eq!(m.snapshot(), before);
+                assert_eq!(m.outcome().steps, frames);
+                // Raise only the soft limit in this same process, preserving the rejected prefix.
+                unsafe {
