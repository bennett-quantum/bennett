+        } else {
+            let e = r.unwrap_err().to_string();
+            assert!(e.contains("§12.2") && e.contains("host limit"), "{e}");
+        }
+    }
+    eprintln!("R21 exhaustive power/product / samples / oracle replay region: 4 paths / 30 cases");
