+pub(crate) fn compare(pred: &str, a: u128, b: u128, w: u16) -> Result<bool> {
+    Ok(match pred {
+        "eq" => a == b,
+        "ne" => a != b,
+        "ult" => a < b,
+        "ule" => a <= b,
+        "slt" => signed(a, w) < signed(b, w),
+        "sle" => signed(a, w) <= signed(b, w),
+        _ => return err("§4.8", format!("unknown comparison {pred}")),
