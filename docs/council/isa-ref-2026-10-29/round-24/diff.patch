+#[cfg(test)]
+mod r23_cli {
+    use super::*;
+    use std::cell::RefCell;
+    thread_local! { static PLAN: RefCell<Option<(usize, Vec<String>)>> = const { RefCell::new(None) }; }
+    fn start(index: usize) {
+        PLAN.with(|p| *p.borrow_mut() = Some((index, Vec::new())));
+    }
